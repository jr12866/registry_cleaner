  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RegistryCleaner.Core\RegistryCleaner.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

</Project>
