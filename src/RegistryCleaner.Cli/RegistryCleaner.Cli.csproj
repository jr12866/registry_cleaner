<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RegistryCleaner.Cli
    The 'rc' command-line interface: the primary and fully-featured front-end.
    It is a thin shell over RegistryCleaner.Core.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>RegistryCleaner.Cli</RootNamespace>
    <AssemblyName>rc</AssemblyName>
