<Window x:Class="RegistryCleaner.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Registry Cleaner"
        Height="520" Width="900"
        MinHeight="400" MinWidth="720"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Heading">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Muted">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource Heading}" Text="Registry Cleaner" />
            <TextBlock Style="{StaticResource Muted}"
                       Text="Find, review, and remove stale Windows registry entries. Every finding is ranked by severity and carries evidence; nothing is removed without your selection, and every removal is backed by a verified backup." />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,16,0,0" Padding="12" CornerRadius="6"
                BorderThickness="1" BorderBrush="#DDDDDD" Background="#F7F7F7">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="2" Margin="0,16,0,0" Padding="16" CornerRadius="6"
                BorderThickness="1" BorderBrush="#DDDDDD">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Heading}" Text="No scan yet" />
                <TextBlock Style="{StaticResource Muted}"
                           Text="The scan view arrives in milestone M1. It will list findings grouped by severity, with the evidence for each one and a detail pane explaining what removing it does." />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="ScanButton" Content="Scan" Width="110" Height="32"
                    IsEnabled="False" Click="ScanButton_Click" />
        </StackPanel>
    </Grid>
</Window>
